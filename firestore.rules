rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'styleProfileMemory',
          'styleProfileUpdatedAt'
        ])
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string
            && request.resource.data.name.size() <= 100))
        && (!('email' in request.resource.data)
          || (
            'email' in request.auth.token
            && request.resource.data.email == request.auth.token.email
          ))
        && (!('styleProfileMemory' in request.resource.data)
          || validStyleProfile(request.resource.data.styleProfileMemory))
        && (!('styleProfileUpdatedAt' in request.resource.data)
          || request.resource.data.styleProfileUpdatedAt is timestamp);
    }

    function validStyleProfile(profile) {
      return profile is map
        && profile.keys().hasOnly([
          'summary',
          'dominantLabels',
          'preferredColors',
          'recurringPieces',
          'stylingThemes',
          'sourceLooks',
          'memoryStatus',
          'confidence'
        ])
        && profile.summary is string
        && profile.summary.size() <= 500
        && profile.dominantLabels is list
        && profile.dominantLabels.size() <= 5
        && profile.preferredColors is list
        && profile.preferredColors.size() <= 5
        && profile.recurringPieces is list
        && profile.recurringPieces.size() <= 6
        && profile.stylingThemes is list
        && profile.stylingThemes.size() <= 4
        && profile.sourceLooks is number
        && profile.sourceLooks >= 0;
    }

    function validRecommendationPayload(payload) {
      return payload is map
        && payload.keys().hasOnly([
          'images',
          'fashionRecommendations',
          'recommendationItems'
        ])
        && payload.images is list
        && payload.images.size() >= 3
        && payload.images.size() <= 6
        && payload.fashionRecommendations is string
        && payload.fashionRecommendations.size() <= 20000
        && payload.recommendationItems is list
        && payload.recommendationItems.size() >= 3
        && payload.recommendationItems.size() <= 6;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId) && validUserDocument();
      allow delete: if false;
    }

    match /userRecommendations/{recommendationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'email',
          'recommendations',
          'styleProfileSnapshot',
          'timestamp'
        ])
        && request.resource.data.userId == request.auth.uid
        && (!('email' in request.resource.data)
          || (
            'email' in request.auth.token
            && request.resource.data.email == request.auth.token.email
          ))
        && validRecommendationPayload(request.resource.data.recommendations)
        && (!('styleProfileSnapshot' in request.resource.data)
          || validStyleProfile(request.resource.data.styleProfileSnapshot))
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
